  "schema_version": "1.1",
  "updated_at": "2026-07-28",
  "locks": [],
  "coordinator_controlled": [
    "package.json",
    "package-lock.json",
    "pnpm-lock.yaml",
    "yarn.lock",
    ".github/workflows/*",
    "supabase/migrations/*"
  ],
  "shared_files_default_owner": {
    "README.md": "oss_maintainer_experience",
    "LICENSE": "oss_maintainer_experience",
    "CHANGELOG.md": "oss_maintainer_experience",
    ".github/workflows/*": "testing_and_ci",
    "supabase/migrations/*": "security_and_privacy",
    "package.json": "coordinator"
  }
}
